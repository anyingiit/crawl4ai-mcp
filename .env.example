# Copy to .env (mode 0600) and fill in real values.
# Never commit this file. Empty values disable the corresponding provider.

RAYOBYTE_API_URL=
RAYOBYTE_API_KEY=
FIRECRAWL_API_KEY=

# Comma-separated proxy URLs. Credentials never belong in the URL
# (userinfo is rejected); set the matching *_PROXY_USERNAME/_PROXY_PASSWORD
# pair below. A proxy URL without credentials is used unauthenticated;
# a partial pair (username without password or vice versa) is rejected.
WEBSHARE_PROXIES=
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=
OXYLABS_PROXIES=
OXYLABS_PROXY_USERNAME=
OXYLABS_PROXY_PASSWORD=
